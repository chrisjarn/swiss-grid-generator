<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tactile Brutalism — 2026 Vector Concept</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/fabric.js/5.3.1/fabric.min.js"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap');
    
    :root {
      --brutal: #ff2a6d;
    }
    body {
      font-family: 'Inter', system-ui, sans-serif;
    }
    .title-font {
      font-family: 'Space Grotesk', sans-serif;
    }
    #canvas {
      background: 
        linear-gradient(to right, #1a1a1a 1px, transparent 1px),
        linear-gradient(to bottom, #1a1a1a 1px, transparent 1px);
      background-size: 40px 40px;
    }
    .glass {
      background: rgba(30, 30, 30, 0.85);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(255,255,255,0.08);
    }
    .toolbar-btn {
      transition: all 0.1s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .toolbar-btn:hover {
      background: #ff2a6d;
      color: white;
      transform: translateY(-1px);
    }
    .selected {
      background: #ff2a6d !important;
      color: white;
    }
  </style>
</head>
<body class="bg-zinc-950 text-zinc-100 overflow-hidden h-screen flex flex-col">
  <!-- Top Bar -->
  <div class="h-11 border-b border-zinc-800 glass flex items-center px-4 justify-between z-50">
    <div class="flex items-center gap-6">
      <div class="flex items-center gap-2">
        <div class="w-6 h-6 bg-white rotate-45"></div>
        <span class="title-font text-xl font-semibold tracking-tighter">TACTILE</span>
      </div>
      <div class="flex gap-5 text-sm">
        <a href="#" class="hover:text-white text-zinc-400">File</a>
        <a href="#" class="hover:text-white text-zinc-400">Edit</a>
        <a href="#" class="hover:text-white text-zinc-400">View</a>
        <a href="#" class="hover:text-white text-zinc-400">Object</a>
      </div>
    </div>
    
    <div class="flex items-center gap-3 text-sm">
      <div class="px-3 py-1 rounded-full bg-zinc-900 border border-zinc-700 flex items-center gap-2">
        <div class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></div>
        <span>Live • 3 collaborators</span>
      </div>
      <button onclick="alert('AI Assistant opened (demo)')" 
              class="px-4 py-1.5 bg-white text-black rounded-xl flex items-center gap-2 hover:bg-amber-300 transition">
        <i class="fa-solid fa-wand-magic-sparkles"></i>
        <span class="font-medium">Ask AI</span>
      </button>
    </div>
  </div>

  <div class="flex flex-1 overflow-hidden">
    <!-- Left Toolbar -->
    <div class="w-14 bg-zinc-900 border-r border-zinc-800 flex flex-col items-center py-4 gap-2 z-50">
      <button onclick="setTool(0)" id="tool0" class="toolbar-btn w-10 h-10 flex items-center justify-center text-2xl rounded-xl selected"><i class="fa-solid fa-arrow-pointer"></i></button>
      <button onclick="setTool(1)" id="tool1" class="toolbar-btn w-10 h-10 flex items-center justify-center text-2xl rounded-xl"><i class="fa-solid fa-pen"></i></button>
      <button onclick="setTool(2)" id="tool2" class="toolbar-btn w-10 h-10 flex items-center justify-center text-2xl rounded-xl"><i class="fa-solid fa-square"></i></button>
      <button onclick="setTool(3)" id="tool3" class="toolbar-btn w-10 h-10 flex items-center justify-center text-2xl rounded-xl"><i class="fa-solid fa-circle"></i></button>
      <button onclick="setTool(4)" id="tool4" class="toolbar-btn w-10 h-10 flex items-center justify-center text-2xl rounded-xl"><i class="fa-solid fa-font"></i></button>
      <div class="flex-1"></div>
      <button onclick="toggleLayers()" class="toolbar-btn w-10 h-10 flex items-center justify-center text-xl rounded-xl"><i class="fa-solid fa-layer-group"></i></button>
    </div>

    <!-- Canvas Area -->
    <div class="flex-1 flex flex-col relative" id="canvas-container">
      <canvas id="canvas" class="flex-1" width="1200" height="800"></canvas>
      
      <!-- Floating status -->
      <div class="absolute bottom-4 left-4 glass px-3 py-1 text-xs rounded-2xl flex items-center gap-2">
        <span class="text-emerald-400">●</span>
        Grid Snap: 20px
      </div>
      
      <div onclick="focusObject()" class="absolute top-4 right-4 glass px-4 py-2 rounded-3xl text-sm flex items-center gap-2 cursor-pointer hover:bg-white hover:text-black transition">
        <i class="fa-solid fa-expand"></i>
        <span>Focus Selection</span>
      </div>
    </div>

    <!-- Right Inspector -->
    <div class="w-80 bg-zinc-900 border-l border-zinc-800 flex flex-col glass overflow-auto">
      <div class="p-4 border-b border-zinc-800">
        <div class="uppercase text-xs tracking-widest text-zinc-500 mb-2">Properties</div>
        <div id="selection-info" class="text-sm">Rectangle • 420 × 280 px</div>
      </div>
      
      <div class="p-4 space-y-6">
        <!-- Transform -->
        <div>
          <div class="text-xs uppercase tracking-widest text-zinc-500 mb-3">Transform</div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="text-xs block mb-1 text-zinc-400">X</label>
              <input id="x" type="number" value="320" class="w-full bg-zinc-950 border border-zinc-700 rounded-2xl px-4 py-3 text-sm focus:outline-none focus:border-white">
            </div>
            <div>
              <label class="text-xs block mb-1 text-zinc-400">Y</label>
              <input id="y" type="number" value="240" class="w-full bg-zinc-950 border border-zinc-700 rounded-2xl px-4 py-3 text-sm focus:outline-none focus:border-white">
            </div>
            <div>
              <label class="text-xs block mb-1 text-zinc-400">W</label>
              <input id="w" type="number" value="420" class="w-full bg-zinc-950 border border-zinc-700 rounded-2xl px-4 py-3 text-sm focus:outline-none focus:border-white">
            </div>
            <div>
              <label class="text-xs block mb-1 text-zinc-400">H</label>
              <input id="h" type="number" value="280" class="w-full bg-zinc-950 border border-zinc-700 rounded-2xl px-4 py-3 text-sm focus:outline-none focus:border-white">
            </div>
          </div>
        </div>

        <!-- Appearance -->
        <div>
          <div class="text-xs uppercase tracking-widest text-zinc-500 mb-3">Appearance</div>
          <div class="flex gap-3">
            <div class="flex-1">
              <label class="text-xs block mb-1 text-zinc-400">Fill</label>
              <div onclick="changeColor()" class="h-10 rounded-2xl bg-[#ff2a6d] border border-zinc-700 cursor-pointer"></div>
            </div>
            <div class="flex-1">
              <label class="text-xs block mb-1 text-zinc-400">Stroke</label>
              <div class="h-10 rounded-2xl bg-transparent border-2 border-white cursor-pointer"></div>
            </div>
          </div>
        </div>

        <!-- Effects -->
        <div>
          <div class="flex justify-between text-xs uppercase tracking-widest text-zinc-500 mb-3">
            <span>Effects</span>
            <span class="text-emerald-400 cursor-pointer">+</span>
          </div>
          <div class="space-y-2 text-sm">
            <div class="flex items-center justify-between glass rounded-3xl px-4 py-3">
              <span>Drop Shadow</span>
              <input type="checkbox" checked class="accent-white">
            </div>
            <div class="flex items-center justify-between glass rounded-3xl px-4 py-3">
              <span>Inner Glow</span>
              <input type="checkbox" class="accent-white">
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="h-9 bg-zinc-900 border-t border-zinc-800 flex items-center px-4 text-xs text-zinc-400">
    <div class="flex-1 flex items-center gap-6">
      <span onclick="addRect()" class="cursor-pointer hover:text-white">+ Rectangle</span>
      <span onclick="addCircle()" class="cursor-pointer hover:text-white">+ Circle</span>
      <span onclick="addText()" class="cursor-pointer hover:text-white">+ Text</span>
    </div>
    <div class="flex items-center gap-4">
      <span>Zoom: <span id="zoom-level" class="text-white">100%</span></span>
      <button onclick="undo()" class="hover:text-white"><i class="fa-solid fa-rotate-left"></i></button>
    </div>
  </div>

  <script>
    // Initialize Fabric.js Canvas
    const canvasEl = document.getElementById('canvas');
    const canvas = new fabric.Canvas('canvas', {
      width: 1400,
      height: 900,
      backgroundColor: '#111111',
      selectionColor: 'rgba(255, 42, 109, 0.2)',
      selectionBorderColor: '#ff2a6d',
      selectionLineWidth: 2,
    });

    // Add some demo objects
    function createDemoObjects() {
      // Big rectangle
      const rect = new fabric.Rect({
        left: 320,
        top: 240,
        width: 420,
        height: 280,
        fill: '#ff2a6d',
        stroke: '#ffffff',
        strokeWidth: 3,
        shadow: new fabric.Shadow({ color: 'rgba(0,0,0,0.6)', blur: 30, offsetX: 10, offsetY: 15 }),
        cornerColor: '#ffffff',
        cornerSize: 10,
        transparentCorners: false
      });
      canvas.add(rect);

      // Circle
      const circle = new fabric.Circle({
        left: 820,
        top: 380,
        radius: 110,
        fill: '#00f5ff',
        stroke: '#ffffff',
        strokeWidth: 4,
        shadow: new fabric.Shadow({ color: 'rgba(0,245,255,0.4)', blur: 40 })
      });
      canvas.add(circle);

      // Text
      const text = new fabric.Text('BRUTAL', {
        left: 520,
        top: 520,
        fontSize: 92,
        fontFamily: 'Space Grotesk',
        fill: '#ffffff',
        fontWeight: '700',
        shadow: new fabric.Shadow({ color: '#000000', blur: 10, offsetY: 8 })
      });
      canvas.add(text);

      canvas.setActiveObject(rect);
      updateInspector();
    }

    // Tool selection
    let currentTool = 0;
    function setTool(n) {
      document.querySelectorAll('.toolbar-btn').forEach((b,i) => {
        b.classList.toggle('selected', i === n);
      });
      currentTool = n;
      if (n === 1) canvas.isDrawingMode = true;
      else canvas.isDrawingMode = false;
    }

    // Inspector sync
    function updateInspector() {
      const active = canvas.getActiveObject();
      if (!active) return;
      
      document.getElementById('selection-info').textContent = 
        `${active.type.charAt(0).toUpperCase() + active.type.slice(1)} • ${Math.round(active.width * active.scaleX)} × ${Math.round(active.height * active.scaleY)} px`;
      
      document.getElementById('x').value = Math.round(active.left);
      document.getElementById('y').value = Math.round(active.top);
      document.getElementById('w').value = Math.round(active.width * active.scaleX);
      document.getElementById('h').value = Math.round(active.height * active.scaleY);
    }

    canvas.on('object:modified', updateInspector);
    canvas.on('selection:created', updateInspector);
    canvas.on('selection:updated', updateInspector);
    canvas.on('selection:cleared', () => {
      document.getElementById('selection-info').textContent = 'Nothing selected';
    });

    // Quick add functions
    function addRect() {
      const rect = new fabric.Rect({
        left: 200 + Math.random()*400,
        top: 150 + Math.random()*300,
        width: 280,
        height: 180,
        fill: '#ff2a6d',
        stroke: '#fff',
        strokeWidth: 3
      });
      canvas.add(rect);
      canvas.setActiveObject(rect);
    }

    function addCircle() {
      const circle = new fabric.Circle({
        left: 300 + Math.random()*400,
        top: 200 + Math.random()*300,
        radius: 90,
        fill: '#00f5ff',
        stroke: '#fff',
        strokeWidth: 4
      });
      canvas.add(circle);
      canvas.setActiveObject(circle);
    }

    function addText() {
      const text = new fabric.Text('NEW TEXT', {
        left: 400,
        top: 300,
        fontSize: 68,
        fontFamily: 'Space Grotesk',
        fill: '#ffffff',
        fontWeight: 700
      });
      canvas.add(text);
      canvas.setActiveObject(text);
    }

    function changeColor() {
      const active = canvas.getActiveObject();
      if (active) {
        active.set('fill', '#00f5ff');
        canvas.renderAll();
      }
    }

    function focusObject() {
      const active = canvas.getActiveObject();
      if (active) {
        canvas.zoomToPoint({x: active.left + active.width/2, y: active.top + active.height/2}, 1.8);
        canvas.renderAll();
      }
    }

    function undo() {
      if (canvas._objects.length > 0) {
        canvas.remove(canvas._objects[canvas._objects.length-1]);
        canvas.renderAll();
      }
    }

    function toggleLayers() {
      alert("Layers panel would slide out here in full version.\n\nDemo uses Fabric.js — fully interactive vector editing.");
    }

    // Keyboard shortcuts
    document.addEventListener('keydown', e => {
      if (e.key === 'Delete' || e.key === 'Backspace') {
        const active = canvas.getActiveObject();
        if (active) canvas.remove(active);
      }
      if (e.metaKey && e.key === 'z') undo();
      if (e.key === '+' || e.key === '=') canvas.setZoom(canvas.getZoom() * 1.2);
      if (e.key === '-') canvas.setZoom(canvas.getZoom() / 1.2);
    });

    // Tailwind script
    createDemoObjects();
    
    // Auto resize canvas a bit
    setTimeout(() => {
      canvas.setDimensions({width: document.getElementById('canvas-container').offsetWidth - 20, height: 780});
      canvas.renderAll();
    }, 300);

    console.log('%cTactile Brutalism 2026 Demo ready. Drag objects, resize, select tools.', 'color:#ff2a6d; font-size:13px');
  </script>
</body>
</html>