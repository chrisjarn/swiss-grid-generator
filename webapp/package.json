{
  "name": "webapp",
  "version": "2.0.11",
  "private": true,
  "type": "module",
  "config": {
    "releaseChannel": "beta"
  },
  "scripts": {
    "messages:generate": "node scripts/build-message-bundle.mjs",
    "help:generate": "node scripts/generate-help-content.mjs",
    "tooltips:generate": "node scripts/generate-tooltip-content.mjs",
    "legal:generate": "node scripts/generate-legal-content.mjs",
    "manual:generate": "node scripts/generate-manual-preset.mjs",
    "presets:manifest": "node scripts/generate-preset-manifest.mjs",
    "fonts:verify": "node --import ./scripts/register-ts-alias-loader.mjs scripts/verify-font-assets.mjs",
    "assets:generate": "npm run messages:generate && npm run manual:generate && npm run presets:manifest && npm run help:generate && npm run tooltips:generate && npm run legal:generate && npm run fonts:verify",
    "predev": "npm run assets:generate",
    "dev": "next dev",
    "predev:beta": "npm run assets:generate",
    "prebuild": "npm run assets:generate",
    "dev:beta": "NEXT_PUBLIC_RELEASE_CHANNEL=beta next dev",
    "predev:prod": "npm run assets:generate",
    "dev:prod": "NEXT_PUBLIC_RELEASE_CHANNEL=prod next dev",
    "build": "next build",
    "storybook": "npm run assets:generate && storybook dev -p 6006",
    "build:storybook": "npm run assets:generate && storybook build",
    "prebuild:beta": "npm run assets:generate",
    "build:beta": "NEXT_PUBLIC_RELEASE_CHANNEL=beta next build",
    "prebuild:prod": "npm run assets:generate",
    "build:prod": "NEXT_PUBLIC_RELEASE_CHANNEL=prod next build",
    "prestart": "npm run assets:generate",
    "start": "next start",
    "prelint": "npm run assets:generate",
    "lint": "eslint app core gui shared lib --max-warnings=0",
    "pretest:presets": "npm run assets:generate",
    "pretest:integration": "npm run assets:generate",
    "test": "npm run test:integration && npm run test:core && npm run test:contracts && npm run test:gui",
    "test:core": "node --import ./scripts/register-ts-alias-loader.mjs --test tests/core/*.test.mjs",
    "test:contracts": "node --import ./scripts/register-ts-alias-loader.mjs --test tests/contracts/*.test.mjs",
    "test:gui": "node --import ./scripts/register-ts-alias-loader.mjs --test tests/gui/*.test.mjs",
    "test:integration": "node --import ./scripts/register-ts-alias-loader.mjs --test tests/integration/*.test.mjs",
    "test:presets": "node --import ./scripts/register-ts-alias-loader.mjs --test tests/integration/preset-project-format.test.mjs",
    "test:roundtrip": "node --import ./scripts/register-ts-alias-loader.mjs --test tests/integration/font-roundtrip.test.mjs",
    "test:grid": "node --import ./scripts/register-ts-alias-loader.mjs --test tests/core/grid-calculator.test.mjs",
    "test:reflow": "node --import ./scripts/register-ts-alias-loader.mjs --test tests/core/reflow-worker-contract.test.mjs",
    "test:autofit": "node --import ./scripts/register-ts-alias-loader.mjs --test tests/core/autofit-planner.test.mjs",
    "test:canvas-renderer": "node --import ./scripts/register-ts-alias-loader.mjs --test tests/contracts/canvas-page-renderer.test.mjs",
    "test:document-variables": "node --import ./scripts/register-ts-alias-loader.mjs --test tests/integration/document-variable-text.test.mjs",
    "test:project-transfer": "node --import ./scripts/register-ts-alias-loader.mjs --test tests/contracts/project-transfer-contract.test.mjs",
    "test:snapshot": "node --import ./scripts/register-ts-alias-loader.mjs --test tests/gui/preview-layout-snapshot.test.mjs",
    "test:text": "node --import ./scripts/register-ts-alias-loader.mjs --test tests/core/text-layout.test.mjs",
    "test:text-tracking": "node --import ./scripts/register-ts-alias-loader.mjs --test tests/core/text-tracking-runs.test.mjs",
    "test:text-rendering": "node --import ./scripts/register-ts-alias-loader.mjs --test tests/core/text-rendering.test.mjs",
    "test:text-metrics": "node --import ./scripts/register-ts-alias-loader.mjs --test tests/contracts/deterministic-text-metrics-contract.test.mjs",
    "test:typography-layout": "node --import ./scripts/register-ts-alias-loader.mjs --test tests/core/typography-layout-plan.test.mjs",
    "test:inline-editor": "node --import ./scripts/register-ts-alias-loader.mjs --test tests/gui/inline-editor-*.test.mjs",
    "test:preview-interactions": "node scripts/run-preview-interaction-smoke.mjs",
    "test:editor-interactions": "node --import ./scripts/register-ts-alias-loader.mjs --test tests/gui/editor-interaction-ownership.test.mjs",
    "test:preview-helpers": "node --import ./scripts/register-ts-alias-loader.mjs --test tests/gui/preview-helpers.test.mjs",
    "test:copy-affordance": "npm run test:preview-helpers",
    "test:optical": "node --import ./scripts/register-ts-alias-loader.mjs --test tests/core/optical-margin.test.mjs",
    "test:pdf": "node --import ./scripts/register-ts-alias-loader.mjs --test tests/contracts/pdf-export-rotation-contract.test.mjs",
    "test:svg": "node --import ./scripts/register-ts-alias-loader.mjs --test tests/contracts/svg-export-contract.test.mjs",
    "test:idml": "node --import ./scripts/register-ts-alias-loader.mjs --test tests/contracts/idml-export-contract.test.mjs",
    "test:export-box": "node --import ./scripts/register-ts-alias-loader.mjs --test tests/contracts/export-box-contract.test.mjs",
    "test:export-geometry": "node --import ./scripts/register-ts-alias-loader.mjs --test tests/contracts/export-geometry-parity.test.mjs",
    "test:perf": "node --import ./scripts/register-ts-alias-loader.mjs --test tests/core/perf-smoke.test.mjs",
    "test:page-export-plan": "node --import ./scripts/register-ts-alias-loader.mjs --test tests/contracts/page-export-plan-contract.test.mjs",
    "test:text-quality": "node --import ./scripts/register-ts-alias-loader.mjs --test tests/contracts/text-quality-contract.test.mjs",
    "export": "node --import ./scripts/register-ts-alias-loader.mjs scripts/export-project.mjs",
    "benchmark:layout": "node --import ./scripts/register-ts-alias-loader.mjs scripts/benchmark-page-export-plan.mjs",
    "fixtures:performance": "node scripts/generate-performance-fixture.mjs",
    "fonts:sync": "../.venv-fonttools/bin/python scripts/sync_google_font_assets.py"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-slider": "^1.2.0",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@supabase/supabase-js": "^2.105.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.2",
    "fflate": "^0.8.2",
    "jspdf": "^4.1.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.18",
    "opentype.js": "^1.3.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/nextjs-vite": "^10.3.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.18",
    "postcss": "^8.4.49",
    "storybook": "^10.3.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
